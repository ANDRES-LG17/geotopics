# Copia este archivo como `.env.local` y rellena los valores.
# En Vercel: Project Settings → Environment Variables.

# URL canónica de producción. Sin ella, hreflang y sitemap apuntan al dominio
# por defecto (https://geotopics.vercel.app).
NEXT_PUBLIC_SITE_URL=https://geotopics.vercel.app

# Formulario de contacto — https://resend.com (plan gratuito: 3000 correos/mes)
# Sin esta clave, /api/contact responde 500 y el formulario muestra un error.
RESEND_API_KEY=

# Dirección remitente. Requiere dominio verificado en Resend.
# Si lo dejas vacío se usa onboarding@resend.dev (válido para pruebas).
CONTACT_FROM_EMAIL=
